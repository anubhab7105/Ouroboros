# =============================================================================
# MULEGUARD root environment example
# -----------------------------------------------------------------------------
# Safe-to-commit template for local development and Docker Compose deployment.
#
# Copy this file:
#   Unix/macOS:
#     cp .env.example .env
#
#   Windows PowerShell:
#     Copy-Item .env.example .env
#
# Security rules:
#   1. Never commit the real .env file.
#   2. Never put real secrets, passwords, API keys, or customer data here.
#   3. Replace every CHANGE_ME value before running.
#   4. For production-like environments, disable seeded demo users and
#      synthetic demo seeding unless explicitly required.
# =============================================================================


# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
BACKEND_APP_NAME=MULEGUARD
BACKEND_ENV=local
BACKEND_DEBUG=false
BACKEND_TIMEZONE=UTC
BACKEND_DEFAULT_LOCALE=en
BACKEND_DEFAULT_CURRENCY=INR
BACKEND_DATASET_MODE=synthetic
BACKEND_SYNTHETIC_BANNER_TEXT=SYNTHETIC DEMO DATA
BACKEND_API_PREFIX=/api/v1

# local | staging | production
# For production, set:
#   BACKEND_ENV=production
#   BACKEND_DEBUG=false
#   BACKEND_OPENAPI_ENABLED=false
#   BACKEND_DOCS_ENABLED=false
#   SEED_DEV_USERS=false
#   SEED_DEMO_DATA=false


# -----------------------------------------------------------------------------
# Logging and observability
# -----------------------------------------------------------------------------
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_JSON=false
BACKEND_LOG_REQUEST_BODY=false
BACKEND_LOG_RESPONSE_BODY=false
BACKEND_LOG_SQL=false
BACKEND_LOG_GRAPH_QUERIES=true
BACKEND_LOG_ANALYSIS_RUNS=true
BACKEND_LOG_SENSITIVE_FIELDS=password,secret,token,authorization,otp,pin,card_number,narrative
BACKEND_MAX_NARRATIVE_LOG_CHARS=200

REQUEST_ID_HEADER=X-Request-ID
BACKEND_ENABLE_REQUEST_ID=true
BACKEND_ENABLE_PERFORMANCE_MIDDLEWARE=true
BACKEND_SLOW_REQUEST_THRESHOLD_MS=2000

# Optional observability integrations should remain disabled by default.
PROMETHEUS_ENABLED=false
OTEL_ENABLED=false
SENTRY_DSN=


# -----------------------------------------------------------------------------
# Docker Compose / service ports
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=muleguard
TZ=UTC
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_WORKERS=1
BACKEND_KEEP_ALIVE_TIMEOUT_SECONDS=5
BACKEND_REQUEST_TIMEOUT_SECONDS=60
BACKEND_MAX_REQUEST_BODY_MB=10
BACKEND_TRUST_PROXY_HEADERS=false
BACKEND_FORWARDED_ALLOW_IPS=

FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173
FRONTEND_PREVIEW_PORT=4173
FRONTEND_PUBLIC_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# For Docker Compose, the backend container usually uses POSTGRES_HOST=db.
# For local backend development outside Docker, use POSTGRES_HOST=localhost.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muleguard
POSTGRES_USER=muleguard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_POOL_RECYCLE_SECONDS=1800
POSTGRES_POOL_PRE_PING=true
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_SSL_MODE=prefer
POSTGRES_SSL_ROOT_CERT=
POSTGRES_SSL_CERT=
POSTGRES_SSL_KEY=

# Explicit SQLAlchemy database URL.
# For Docker Compose, change host to:
#   postgresql+psycopg2://muleguard:CHANGE_ME_STRONG_POSTGRES_PASSWORD@db:5432/muleguard
DATABASE_URL=postgresql+psycopg2://muleguard:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5432/muleguard

# Optional quick SQLite local development mode.
# Use only for local development and tests, not for Docker deployment.
# DATABASE_URL=sqlite:///./muleguard.db
BACKEND_ALLOW_SQLITE_FOR_LOCAL_DEV=true


# -----------------------------------------------------------------------------
# Alembic migrations
# -----------------------------------------------------------------------------
ALEMBIC_CONFIG_PATH=backend/alembic.ini
ALEMBIC_UPGRADE_ON_START=true
ALEMBIC_SEED_REFERENCE_DATA=true


# -----------------------------------------------------------------------------
# Backend HTTP security
# -----------------------------------------------------------------------------
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
BACKEND_CORS_ALLOW_CREDENTIALS=true
BACKEND_SECURE_HEADERS_ENABLED=true
BACKEND_X_CONTENT_TYPE_OPTIONS=nosniff
BACKEND_X_FRAME_OPTIONS=DENY
BACKEND_REFERRER_POLICY=no-referrer
BACKEND_HSTS_ENABLED=false
BACKEND_CONTENT_SECURITY_POLICY_ENABLED=false

# Generate a strong secret, for example:
#   openssl rand -hex 64
BACKEND_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS

BACKEND_SECRET_KEY_ROTATION_DAYS=90
BACKEND_REQUIRE_STRONG_SECRET_IN_NON_LOCAL=true


# -----------------------------------------------------------------------------
# Authentication and session behavior
# -----------------------------------------------------------------------------
AUTH_ENABLED=true
AUTH_MODE=jwt_bearer
AUTH_TOKEN_SCHEME=Bearer
AUTH_TOKEN_HEADER=Authorization
AUTH_ISSUER=muleguard.local
AUTH_AUDIENCE=muleguard-client
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=1
AUTH_SESSION_TIMEOUT_MINUTES=60
AUTH_ALLOW_INACTIVE_USER_LOGIN=false
AUTH_ALLOW_SELF_REGISTRATION=false
AUTH_REQUIRE_PASSWORD_RESET_FOR_SEEDED_USERS=false

# Password hashing:
# Prefer argon2id where dependency support is stable.
# bcrypt is acceptable if Argon2 dependencies are unavailable.
AUTH_PASSWORD_HASH_SCHEME=argon2id
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_PARALLELISM=2
AUTH_BCRYPT_ROUNDS=12

# Login throttling / rate limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=5
AUTH_RATE_LIMIT_LOGIN=5/minute
AUTH_RATE_LIMIT_GLOBAL=300/minute
AUTH_RATE_LIMIT_ANALYSIS=5/minute
AUTH_RATE_LIMIT_GRAPH=60/minute
AUTH_RATE_LIMIT_REPORT=10/minute
AUTH_RATE_LIMIT_INGESTION=10/minute
AUTH_RATE_LIMIT_STORAGE=memory
AUTH_RATE_LIMIT_BY=user_and_ip

# Cookie/session hardening.
# For local HTTP development, AUTH_COOKIE_SECURE=false may be required.
# For HTTPS production, set AUTH_COOKIE_SECURE=true.
AUTH_USE_COOKIES=false
AUTH_COOKIE_NAME=muleguard_auth
AUTH_COOKIE_PATH=/
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Role-based access control
RBAC_ENABLED=true
RBAC_ADMIN_ROLE=ADMIN
RBAC_ANALYST_ROLE=ANALYST
RBAC_SENIOR_INVESTIGATOR_ROLE=SENIOR_INVESTIGATOR
RBAC_AUDITOR_ROLE=AUDITOR

USER_MANAGEMENT_ROLES=ADMIN
ANALYSIS_RUN_ROLES=ADMIN,ANALYST,SENIOR_INVESTIGATOR
INGESTION_RUN_ROLES=ADMIN
SEED_RESET_ROLES=ADMIN
CASE_ASSIGN_ROLES=ADMIN,SENIOR_INVESTIGATOR
CASE_CLOSE_ROLES=ADMIN,SENIOR_INVESTIGATOR
CASE_REOPEN_ROLES=ADMIN,SENIOR_INVESTIGATOR
ALERT_TRIAGE_ROLES=ADMIN,ANALYST,SENIOR_INVESTIGATOR
REPORT_DOWNLOAD_ROLES=ADMIN,ANALYST,SENIOR_INVESTIGATOR,AUDITOR
AUDIT_READ_ROLES=ADMIN,AUDITOR


# -----------------------------------------------------------------------------
# Development/demo users
# -----------------------------------------------------------------------------
# These are local development users only.
# Do not use these values in production.
# Do not commit real passwords.
# -----------------------------------------------------------------------------
SEED_DEV_USERS=true
DEMO_USERS_REQUIRE_PASSWORD_CHANGE=false

DEV_ADMIN_EMAIL=admin@muleguard.local
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD

DEV_ANALYST_EMAIL=analyst@muleguard.local
DEV_ANALYST_USERNAME=analyst
DEV_ANALYST_PASSWORD=CHANGE_ME_DEV_ANALYST_PASSWORD

DEV_SENIOR_INVESTIGATOR_EMAIL=senior@muleguard.local
DEV_SENIOR_INVESTIGATOR_USERNAME=senior_investigator
DEV_SENIOR_INVESTIGATOR_PASSWORD=CHANGE_ME_DEV_SENIOR_PASSWORD

DEV_AUDITOR_EMAIL=auditor@muleguard.local
DEV_AUDITOR_USERNAME=auditor
DEV_AUDITOR_PASSWORD=CHANGE_ME_DEV_AUDITOR_PASSWORD


# -----------------------------------------------------------------------------
# Synthetic data generation and seeding
# -----------------------------------------------------------------------------
# MULEGUARD is synthetic-first by default.
# Do not load real customer data unless you have replaced the synthetic
# pipeline with an approved, secure, privacy-preserving data source.
# -----------------------------------------------------------------------------
SEED_DEMO_DATA=true
SEED_RESET_REQUIRE_CONFIRMATION=true
SEED_RANDOM_SEED=42
SEED_GENERATOR_VERSION=v1

# Quick-start demo dataset
SEED_ACCOUNTS=1200
SEED_TRANSACTIONS=25000
SEED_COMPLAINTS=150
SEED_ENTITY_LINKS=400
SEED_FRAUD_SCENARIOS=12

# Optional larger performance dataset
SEED_LARGE_DATASET=false
SEED_LARGE_ACCOUNTS=10000
SEED_LARGE_TRANSACTIONS=100000
SEED_LARGE_COMPLAINTS=1000
SEED_LARGE_ENTITY_LINKS=2500

SEED_DATE_START=2024-01-01T00:00:00Z
SEED_DATE_END=2024-03-31T23:59:59Z
SEED_TIMEZONE=UTC
SEED_DEFAULT_CURRENCY=INR

SEED_INCLUDE_HARD_NEGATIVES=true
SEED_INCLUDE_DORMANT_ACCOUNTS=true
SEED_INCLUDE_SHARED_ENTITIES=true
SEED_INCLUDE_COMPLAINT_LINKED_TRANSACTIONS=true
SEED_INCLUDE_CYCLES=true
SEED_INCLUDE_LAYERING=true
SEED_INCLUDE_FAN_IN=true
SEED_INCLUDE_FAN_OUT=true
SEED_INCLUDE_RAPID_PASS_THROUGH=true
SEED_INCLUDE_HIGH_VELOCITY=true

SEED_BASE_LEGITIMATE_RATIO=0.90
SEED_FRAUD_SCENARIO_ACCOUNTS_PER_RING_MIN=3
SEED_FRAUD_SCENARIO_ACCOUNTS_PER_RING_MAX=8
SEED_PASS_THROUGH_WINDOW_MINUTES=60
SEED_FAN_IN_MIN_SENDERS=5
SEED_FAN_OUT_MIN_RECEIVERS=5
SEED_LAYERING_MIN_HOPS=3
SEED_CYCLE_MAX_HOPS=4
SEED_DORMANT_QUIET_DAYS=90
SEED_HIGH_VELOCITY_TXNS_PER_DAY=25
SEED_AMOUNT_ANOMALY_ZSCORE=3.0
SEED_COMPLAINT_EXACT_MATCH_RATIO=0.35

# Ground-truth isolation and leakage control
SEED_LEAKAGE_GUARD=true
SEED_LABEL_STORAGE=isolated_table
SEED_GROUND_TRUTH_TABLE=ground_truth_labels
SEED_FORBIDDEN_FEATURE_FIELDS=fraud_label,scenario_id,ground_truth_label,ring_id

# Pseudonymisation and synthetic identifiers
SEED_PSEUDONYMIZE_IDENTIFIERS=true
SEED_IDENTIFIER_HASH_ALGORITHM=sha256
SEED_HASH_SALT=CHANGE_ME_SYNTHETIC_HASH_SALT
SEED_SYNTHETIC_WATERMARK=true
SEED_NARRATIVE_STYLE=synthetic


# -----------------------------------------------------------------------------
# Ingestion and validation
# -----------------------------------------------------------------------------
INGESTION_SOURCE_NAME=local_demo
INGESTION_SOURCE_PROVENANCE_REQUIRED=true
INGESTION_BATCH_SIZE_DEFAULT=1000
INGESTION_MAX_BATCH_SIZE=5000
INGESTION_MAX_REQUEST_MB=10
INGESTION_MAX_ERRORS_RETURNED=100
INGESTION_TRANSACTIONAL_BATCH=true
INGESTION_ALLOW_PARTIAL_BATCH=false
INGESTION_ALLOW_UNKNOWN_FIELDS=false
INGESTION_KEEP_RAW_PAYLOAD=false
INGESTION_LINEAGE_ENABLED=true
INGESTION_BATCH_ID_PREFIX=ingest

INGESTION_ENABLE_CSV=false
INGESTION_CSV_MAX_ROWS=10000

INGESTION_DUPLICATE_TRANSACTION_STRATEGY=reject
INGESTION_DUPLICATE_COMPLAINT_STRATEGY=reject
INGESTION_DUPLICATE_ENTITY_LINK_STRATEGY=reject

INGESTION_REJECT_FUTURE_TIMESTAMPS=true
INGESTION_FUTURE_TOLERANCE_MINUTES=5
INGESTION_AMOUNT_PRECISION=2
INGESTION_DEFAULT_CURRENCY=INR
INGESTION_DEFAULT_TIMEZONE=UTC
INGESTION_MAX_NARRATIVE_CHARS=2000

INGESTION_CURRENCY_ALLOWLIST=INR,USD,EUR
INGESTION_STATUS_ALLOWLIST=pending,completed,failed,reversed
INGESTION_CHANNEL_ALLOWLIST=UPI,IMPS,NEFT,RTGS,CARD,INTERNAL
INGESTION_ACCOUNT_TYPE_ALLOWLIST=individual,business,merchant,other
INGESTION_ENTITY_TYPE_ALLOWLIST=device,phone_hash,upi_id,email_hash,address_hash,ip_hash
INGESTION_MATCH_METHOD_ALLOWLIST=exact,normalized,entity_temporal,graph_temporal,manual


# -----------------------------------------------------------------------------
# Pagination, sorting, and search
# -----------------------------------------------------------------------------
BACKEND_PAGINATION_DEFAULT_PAGE_SIZE=50
BACKEND_PAGINATION_MAX_PAGE_SIZE=200
BACKEND_SEARCH_MAX_LENGTH=200
BACKEND_DEFAULT_SORT_ORDER=created_at_desc


# -----------------------------------------------------------------------------
# Behavioural feature engine
# -----------------------------------------------------------------------------
FEATURE_WINDOWS=1h,24h,7d,30d
FEATURE_AS_OF_TIMEZONE=UTC
FEATURE_MISSING_VALUE_POLICY=documented_zero_or_null
FEATURE_AMOUNT_EPSILON=0.01
FEATURE_DENOMINATOR_EPSILON=0.000001
FEATURE_BASELINE_WINDOW_DAYS=90
FEATURE_ROLLING_BASELINE_MIN_SAMPLES=10
FEATURE_PASSTHROUGH_WINDOW_MINUTES=60
FEATURE_STORE_SNAPSHOTS=true
FEATURE_SNAPSHOT_RETENTION_DAYS=90
FEATURE_POINT_IN_TIME_STRICT=true


# -----------------------------------------------------------------------------
# Rule engine
# -----------------------------------------------------------------------------
RULES_ENABLED=true
RULES_VERSION=v1
RULES_CONFIG_PATH=backend/config/rules.default.json
RULES_FAIL_ON_CONFIG_ERROR=false
RULES_INCLUDE_EVIDENCE=true
RULES_MAX_EVIDENCE_REFERENCES_PER_HIT=100

RULE_ENABLE_RAPID_PASS_THROUGH=true
RULE_ENABLE_HIGH_VELOCITY=true
RULE_ENABLE_FAN_IN=true
RULE_ENABLE_FAN_OUT=true
RULE_ENABLE_DORMANT_TO_ACTIVE=true
RULE_ENABLE_AMOUNT_DEVIATION=true
RULE_ENABLE_LAYERED_PATH=true
RULE_ENABLE_CIRCULAR_MOVEMENT=true
RULE_ENABLE_COMPLAINT_REFERENCE_ASSOCIATION=true
RULE_ENABLE_SUSPICIOUS_NEIGHBOUR_ASSOCIATION=true

RULE_RAPID_PASS_THROUGH_RATIO=0.80
RULE_HIGH_VELOCITY_COUNT=25
RULE_FAN_IN_MIN_SENDERS=5
RULE_FAN_OUT_MIN_RECEIVERS=5
RULE_DORMANT_QUIET_DAYS=90
RULE_AMOUNT_DEVIATION_ZSCORE=3.0
RULE_LAYERED_PATH_MIN_HOPS=3
RULE_CYCLE_MAX_HOPS=4
RULE_NEIGHBOUR_SIGNAL_CAP=0.20
RULE_SHARED_ENTITY_SIGNAL_CAP=0.15


# -----------------------------------------------------------------------------
# Graph analytics and money-trail search
# -----------------------------------------------------------------------------
GRAPH_ENABLED=true
GRAPH_MAX_HOPS=3
GRAPH_NEIGHBORHOOD_DEFAULT_HOPS=2
GRAPH_MAX_NODES=500
GRAPH_MAX_EDGES=1500
GRAPH_MAX_PATHS=20
GRAPH_MAX_DATE_SPAN_DAYS=90
GRAPH_MIN_TRANSFER_AMOUNT=0
GRAPH_MAX_EDGE_AMOUNT=
GRAPH_DEFAULT_PAGE_LIMIT=100
GRAPH_TIMEOUT_SECONDS=15

GRAPH_INCLUDE_FAILED_TRANSACTIONS=false
GRAPH_EDGE_STATUS_FILTER=completed
GRAPH_STRICT_TIME_ORDER=true
GRAPH_ALLOW_SAME_TIMESTAMP=false
GRAPH_SAME_TIMESTAMP_POLICY=reject
GRAPH_PATH_ALLOW_CYCLES=false
GRAPH_PATH_CYCLE_POLICY=reject
GRAPH_PATH_MAX_TIME_GAP_HOURS=72
GRAPH_PATH_VALUE_MATCH_TOLERANCE=0.10
GRAPH_PATH_REQUIRE_MONOTONIC_TIMESTAMPS=true

GRAPH_COMPLAINT_LINK_HOPS=2
GRAPH_TEMPORAL_ASSOCIATION_MAX_DAYS=7
GRAPH_ALERT_NEIGHBOR_SIGNAL_CAP=0.20
GRAPH_SHARED_ENTITY_SIGNAL_CAP=0.15

GRAPH_COMMUNITY_DETECTION_ENABLED=true
GRAPH_COMMUNITY_ALGORITHM=greedy_modularity
GRAPH_COMMUNITY_MAX_NODES=300

GRAPH_CACHE_ENABLED=false
GRAPH_CACHE_TTL_SECONDS=60
GRAPH_CACHE_MAX_ENTRIES=100
GRAPH_CACHE_INCLUDE_DATASET_FINGERPRINT=true

GRAPH_NODE_LABEL_MODE=pseudonymous
GRAPH_SHOW_ENTITY_NODES=true
GRAPH_EXPORT_ENABLED=true
GRAPH_EXPORT_FORMATS=json,png


# -----------------------------------------------------------------------------
# Complaint correlation
# -----------------------------------------------------------------------------
COMPLAINT_AUTO_CORRELATE_ON_INGESTION=true
COMPLAINT_REVIEW_REQUIRED=true
COMPLAINT_TEMPORAL_WINDOW_DAYS=7
COMPLAINT_TEMPORAL_ASSOCIATION_MAX_HOPS=2
COMPLAINT_TEMPORAL_ASSOCIATION_MAX_RESULTS=50
COMPLAINT_EXACT_MATCH_REQUIRES_VALID_SOURCE=true

COMPLAINT_MATCH_CONFIDENCE_EXACT=1.0
COMPLAINT_MATCH_CONFIDENCE_IDENTIFIER=0.85
COMPLAINT_MATCH_CONFIDENCE_ENTITY=0.65
COMPLAINT_MATCH_CONFIDENCE_TEMPORAL=0.35

COMPLAINT_MATCH_TIERS_ENABLED=1,2,3,4
COMPLAINT_TIER5_ENABLED=false
COMPLAINT_NARRATIVE_EXTRACTION_ENABLED=false
COMPLAINT_NARRATIVE_EXTRACTION_METHOD=deterministic_regex
COMPLAINT_NARRATIVE_MAX_PREVIEW_CHARS=200

COMPLAINT_NORMALIZATION_STRIP_WHITESPACE=true
COMPLAINT_NORMALIZATION_CASEFOLD=true
COMPLAINT_NORMALIZE_PHONE=true
COMPLAINT_NORMALIZE_UPI=true
COMPLAINT_NORMALIZE_REFERENCE=true
COMPLAINT_PHONE_HASH_ALGORITHM=sha256


# -----------------------------------------------------------------------------
# Machine learning pipeline
# -----------------------------------------------------------------------------
ML_ARTIFACT_DIR=backend/app/ml/artifacts
ML_MODEL_CARD_PATH=docs/model-card.md

# active scoring mode:
#   auto              use trained model when available, otherwise fallback
#   trained_model     require trained artifact
#   heuristic_fallback always use documented fallback
ML_ACTIVE_SCORING_MODE=auto
ML_FALLBACK_MODE_LABEL=heuristic_fallback
ML_REQUIRE_TRAINED_MODEL=false

ML_ACTIVE_MODEL_VERSION=latest
ML_FEATURE_SCHEMA_VERSION=v1
ML_FEATURE_VALIDATION_STRICT=true
ML_LABEL_LEAKAGE_CHECK=true

ML_TRAINING_SEED=42
ML_SPLIT_STRATEGY=scenario_aware_chronological
ML_SCENARIO_AWARE_SPLIT=true
ML_HOLDOUT_FRACTION=0.25
ML_VALIDATION_FRACTION=0.15
ML_TIME_SPLIT_GAP_DAYS=7
ML_CROSS_VALIDATION_FOLDS=5
ML_TEST_LABEL_MIN_POSITIVES=10
ML_MIN_TRAINING_SAMPLES=200

ML_MODEL_TYPE=hist_gradient_boosting
ML_CLASS_WEIGHT=balanced
ML_EVALUATION_THRESHOLD=0.5
ML_EVAL_TOP_K=50
ML_TOP_K_DEFAULT=50
ML_FAIL_ON_SINGLE_CLASS_EVAL=false
ML_REPORT_UNDEFINED_METRICS_HONESTLY=true
ML_LATENCY_SAMPLE_SIZE=1000

ML_ANOMALY_MODEL_TYPE=isolation_forest
ML_ANOMALY_CONTAMINATION=0.05
ML_ANOMALY_ESTIMATORS=200

ML_HGB_MAX_ITER=200
ML_HGB_LEARNING_RATE=0.05
ML_HGB_MAX_DEPTH=6

ML_CALIBRATION_ENABLED=false
ML_PROBABILITY_CALIBRATION_METHOD=none

ML_ARTIFACT_FORMAT=joblib
ML_ARTIFACT_CHECKSUM_ALGORITHM=sha256
ML_ARTIFACT_CHECKSUM_REQUIRED=true
ML_ARTIFACT_TRUSTED_PATH_ONLY=true
ML_ARTIFACT_LOAD_POLICY=controlled_path_checksum
ML_DISABLE_UNTRUSTED_PICKLE_UPLOADS=true

ML_METADATA_DB_PERSISTENCE=true
ML_EVALUATION_RETENTION_COUNT=10
ML_EXPLANATION_TOP_FEATURES=8
ML_EXPLANATION_METHOD=feature_attribution

SHAP_ENABLED=false
SHAP_MAX_SAMPLES=100

EXPLAINABILITY_INCLUDE_RULES=true
EXPLAINABILITY_INCLUDE_GRAPH=true
EXPLAINABILITY_INCLUDE_COMPLAINTS=true
EXPLAINABILITY_INCLUDE_FEATURE_VALUES=true
EXPLAINABILITY_INCLUDE_MISSING_DATA_NOTES=true


# -----------------------------------------------------------------------------
# Risk fusion and prioritisation
# -----------------------------------------------------------------------------
SCORING_CONFIG_PATH=backend/config/scoring.default.json
RISK_FUSION_VERSION=v1
RISK_FUSION_FORMULA=weighted_normalized_sum
RISK_SCORE_VERSION=v1
RISK_SCORE_TYPE=investigative_priority_score
RISK_SCORE_LABEL=Investigative priority score
RISK_SCORE_DISCLAIMER="Priority score for investigation triage only. It is not a probability of guilt."

RISK_WEIGHT_SUPERVISED=0.35
RISK_WEIGHT_ANOMALY=0.25
RISK_WEIGHT_GRAPH=0.20
RISK_WEIGHT_RULES=0.20

RISK_NORMALIZATION_CLIP_MIN=0
RISK_NORMALIZATION_CLIP_MAX=100
RISK_MISSING_SIGNAL_VALUE=0
RISK_MISSING_SIGNAL_POLICY=neutral_zero

RISK_BAND_LOW_MAX=39
RISK_BAND_MEDIUM_MAX=69
RISK_BAND_HIGH_MAX=89
RISK_BAND_CRITICAL_MAX=100
RISK_CRITICAL_ENABLED=true

RISK_SCORE_HISTORY_ENABLED=true
RISK_ASSESSMENT_RETENTION_DAYS=365


# -----------------------------------------------------------------------------
# Alerts
# -----------------------------------------------------------------------------
ALERT_CREATE_FROM_RULES=true
ALERT_CREATE_FROM_MODEL=true
ALERT_CREATE_FROM_GRAPH=true
ALERT_DEFAULT_STATE=NEW
ALERT_AUTO_ACKNOWLEDGE=false
ALERT_PRIORITY_CALCULATION=score_band

ALERT_DEDUPLICATION_ENABLED=true
ALERT_DEDUPLICATION_STRATEGY=account_window_signal
ALERT_DEDUPLICATION_WINDOW_HOURS=24
ALERT_OPEN_UNIQUE_PER_ACCOUNT_WINDOW=true
ALERT_SUPPRESSION_WINDOW_HOURS=24
ALERT_EVIDENCE_MAX_PER_ALERT=100
ALERT_INCLUDE_EXPLANATION=true


# -----------------------------------------------------------------------------
# Analysis runs
# -----------------------------------------------------------------------------
ANALYSIS_RUN_MODE=sync
ANALYSIS_BATCH_SIZE=500
ANALYSIS_MAX_RUNTIME_SECONDS=300
ANALYSIS_MAX_ACCOUNTS_PER_RUN=10000
ANALYSIS_RETAIN_SCORE_HISTORY=true
ANALYSIS_ENABLE_RUN_LOCK=true
ANALYSIS_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
ANALYSIS_REQUIRE_IDEMPOTENCY_KEY=false
ANALYSIS_RUN_AUDIT_ENABLED=true


# -----------------------------------------------------------------------------
# Case management
# -----------------------------------------------------------------------------
CASE_DEFAULT_STATUS=NEW
CASE_DEFAULT_PRIORITY=MEDIUM
CASE_TITLE_MAX_LENGTH=200
CASE_NOTE_MAX_LENGTH=5000
CASE_MAX_EVIDENCE_PER_CASE=200
CASE_MAX_NOTES_PER_CASE=1000
CASE_ALLOW_REOPEN=true
CASE_REOPEN_REQUIRES_NOTE=true
CASE_CLOSE_REQUIRES_DISPOSITION=true
CASE_EVENT_RETENTION_DAYS=3650

CASE_DISPOSITION_OPTIONS=CONFIRMED_FRAUD,FALSE_POSITIVE,INCONCLUSIVE,REFERRED
CASE_AUDIT_ACTIONS=create,update,assign,evidence_add,evidence_remove,status_change,note_add,report_generate,close,reopen

CASE_FROM_ALERT_AUTO_ATTACH_EVIDENCE=true
CASE_FROM_ALERT_DEFAULT_TITLE_PREFIX=MULEGUARD Investigation


# -----------------------------------------------------------------------------
# Evidence integrity
# -----------------------------------------------------------------------------
EVIDENCE_VALIDATION_STRICT=true
EVIDENCE_ALLOW_EXTERNAL_URLS=false
EVIDENCE_SNAPSHOT_ENABLED=true
EVIDENCE_SNAPSHOT_INCLUDE_PROVENANCE=true
EVIDENCE_MAX_PER_CASE=200
EVIDENCE_MAX_SNAPSHOT_BYTES=262144
EVIDENCE_ALLOWED_TYPES=account,transaction,complaint,alert,graph_path,model_assessment,entity_link
EVIDENCE_GRAPH_PATH_MAX_HOPS=4


# -----------------------------------------------------------------------------
# Audit logging
# -----------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_INCLUDE_REQUEST_METADATA=true
AUDIT_REDACT_NARRATIVES=true
AUDIT_REDACTION_PATTERNS=password,secret,token,authorization,otp,pin,card_number,narrative
AUDIT_MAX_METADATA_BYTES=4096
AUDIT_LOGIN_EVENTS=true
AUDIT_LOGOUT_EVENTS=true
AUDIT_FAILED_LOGIN_EVENTS=true
AUDIT_REPORT_GENERATION_EVENTS=true
AUDIT_CASE_EVENTS=true
AUDIT_INGESTION_EVENTS=true
AUDIT_ANALYSIS_EVENTS=true
AUDIT_USER_MANAGEMENT_EVENTS=true


# -----------------------------------------------------------------------------
# PDF report generation
# -----------------------------------------------------------------------------
REPORT_ENABLED=true
REPORT_TIMEZONE=UTC
REPORT_MAX_GENERATION_SECONDS=30
REPORT_FILENAME_PREFIX=muleguard-case-report
REPORT_INCLUDE_SYNTHETIC_DISCLAIMER=true
REPORT_INCLUDE_LIMITATIONS=true
REPORT_INCLUDE_EVIDENCE_INDEX=true
REPORT_INCLUDE_TRANSACTION_TIMELINE=true
REPORT_INCLUDE_GRAPH_PATHS=true
REPORT_INCLUDE_COMPLAINT_CORRELATIONS=true
REPORT_INCLUDE_RISK_ASSESSMENT=true
REPORT_INCLUDE_NOTES=true
REPORT_INCLUDE_EVENTS=true
REPORT_INCLUDE_AUDIT_EVENTS=false
REPORT_INCLUDE_COMPLAINT_NARRATIVES=false
REPORT_INCLUDE_ENTITY_PROVENANCE=true

REPORT_PAGE_SIZE=A4
REPORT_MARGIN_MM=20
REPORT_HEADER_TEXT=MULEGUARD Investigation Report
REPORT_FOOTER_TEXT=Synthetic prototype only. Alerts and relationships are investigative leads, not proof of wrongdoing.
REPORT_LIMITATIONS_TEXT="This report is generated from synthetic prototype data. Risk indicators, graph associations, and complaint correlations are investigative leads and do not prove wrongdoing."


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
CACHE_NAMESPACE=muleguard
CACHE_INCLUDE_DATASET_VERSION=true


# -----------------------------------------------------------------------------
# Dataset fingerprinting / reproducibility
# -----------------------------------------------------------------------------
DATASET_FINGERPRINT_ALGORITHM=sha256
DATASET_FINGERPRINT_INCLUDE_SEED=true
DATASET_FINGERPRINT_INCLUDE_GENERATOR_VERSION=true
DATASET_FINGERPRINT_INCLUDE_SCHEMA_VERSION=true


# -----------------------------------------------------------------------------
# Frontend runtime variables
# -----------------------------------------------------------------------------
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# For Docker/Nginx deployment behind the same origin, use relative API path:
#   VITE_API_BASE_URL=/api/v1
# For direct local backend access, use:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=30000
VITE_API_RETRY_MAX=2
VITE_API_RETRY_DELAY_MS=500
VITE_API_DEDUPE_INTERVAL_MS=200

VITE_APP_NAME=MULEGUARD
VITE_ENVIRONMENT_LABEL=LOCAL SYNTHETIC DEMO
VITE_SHOW_SYNTHETIC_BANNER=true
VITE_SHOW_SCORE_DISCLAIMER=true
VITE_SHOW_SYNTHETIC_LABEL_DISCLAIMER=true
VITE_SHOW_LIMITATIONS=true
VITE_SHOW_SCORING_MODE=true
VITE_SHOW_MODEL_VERSION=true
VITE_SHOW_EVIDENCE_LINKS=true

VITE_DEFAULT_LOCALE=en
VITE_DEFAULT_CURRENCY=INR
VITE_TIMEZONE=UTC
VITE_DATE_FORMAT=YYYY-MM-DD HH:mm:ss UTC
VITE_CURRENCY_FORMAT_LOCALE=en-IN
VITE_AMOUNT_DECIMAL_PLACES=2

VITE_ROUTER_BASENAME=/
VITE_TOKEN_STORAGE=memory
VITE_AUTO_LOGOUT_MINUTES=60
VITE_SESSION_REFRESH_INTERVAL_SECONDS=300

VITE_TABLE_DEFAULT_PAGE_SIZE=50
VITE_TABLE_MAX_PAGE_SIZE=200

VITE_ENABLE_DASHBOARD=true
VITE_ENABLE_TRANSACTIONS=true
VITE_ENABLE_ACCOUNTS=true
VITE_ENABLE_ALERTS=true
VITE_ENABLE_GRAPH=true
VITE_ENABLE_COMPLAINTS=true
VITE_ENABLE_CASES=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_MODEL_MONITORING=true
VITE_ENABLE_INGESTION=true
VITE_ENABLE_AUDIT_PAGE=true
VITE_ENABLE_USER_MANAGEMENT=true
VITE_ENABLE_GLOBAL_SEARCH=true
VITE_ENABLE_BULK_ACTIONS=false
VITE_ENABLE_ADVANCED_GRAPH_CONTROLS=true
VITE_ENABLE_CASE_EXPORT_PDF=true

VITE_GLOBAL_SEARCH_PLACEHOLDER=Search accounts, transactions, complaints, cases
VITE_BREADCRUMBS_ENABLED=true
VITE_ACCESSIBILITY_HIGH_CONTRAST=false
VITE_REDUCED_MOTION=false

VITE_GRAPH_DEFAULT_HOPS=2
VITE_GRAPH_MAX_RENDERED_NODES=500
VITE_GRAPH_MAX_RENDERED_EDGES=1500
VITE_GRAPH_WARN_ON_LIMIT=true
VITE_GRAPH_LAYOUT=cose
VITE_GRAPH_LAYOUT_ANIMATION_DURATION_MS=300
VITE_GRAPH_NODE_SIZE_BY=degree
VITE_GRAPH_EDGE_WIDTH_BY=amount
VITE_GRAPH_COLOR_BY=risk_band
VITE_GRAPH_SHOW_LEGEND=true
VITE_GRAPH_SHOW_DIRECTION_ARROWS=true
VITE_GRAPH_EXPORT_ENABLED=true
VITE_GRAPH_EXPORT_FORMATS=json,png
VITE_PATH_TABLE_VISIBLE=true
VITE_DISABLE_GRAPH_WHEN_LARGE=true

VITE_ALERT_SORT_DEFAULT=score_desc
VITE_CASE_SORT_DEFAULT=updated_desc
VITE_TRANSACTION_FILTER_STATUS_DEFAULT=completed

VITE_QUERY_STALE_TIME_MS=30000
VITE_QUERY_CACHE_TIME_MS=300000
VITE_QUERY_REFETCH_ON_WINDOW_FOCUS=false

VITE_ENABLE_ERROR_BOUNDARY=true
VITE_ERROR_REPORT_ENDPOINT=

VITE_TELEMETRY_ENABLED=false
VITE_ANALYTICS_ENABLED=false
VITE_SERVICE_WORKER_ENABLED=false
VITE_PWA_ENABLED=false
VITE_OFFLINE_MODE=false


