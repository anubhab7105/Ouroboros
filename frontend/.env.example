# ---------------------------------------------------------------------------
# MULEGUARD frontend environment
#
# Only VITE_-prefixed variables reach the browser bundle, and they are baked in
# at build time rather than read at runtime. Never put a secret here:
# everything in this file is readable by anyone who loads the app.
#
# docker-compose.yml passes these as build args. The names below are the ones
# it uses, so a value set here and a value set there mean the same thing.
# ---------------------------------------------------------------------------

# Base URL for the API. Defaults to same-origin /api/v1, which is what the
# bundled nginx config and the Vite dev proxy both serve. Override only when
# the API is on a different host.
VITE_API_BASE_URL=/api/v1

# Request timeout in milliseconds. The graph and report endpoints are the
# slowest, so this is generous.
VITE_API_TIMEOUT_MS=30000

# Shown in the topbar and on the sign-in page.
VITE_APP_NAME=MuleGuard

# Shown in the footer alongside the API's own version.
VITE_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Safety banners
#
# All three default to ON when unset. A deployment that forgot to configure
# them should over-warn: a spurious banner is mildly annoying, while a missing
# one means somebody may act on generated output as though it described a real
# account.
# ---------------------------------------------------------------------------

# Free text for the standing band at the top of every page.
VITE_ENVIRONMENT_LABEL=LOCAL SYNTHETIC DEMO

# Drives the band's styling. One of: local, development, staging, production.
# When unset it is inferred from VITE_ENVIRONMENT_LABEL.
VITE_ENVIRONMENT=local

# Say in the banner that the data is synthetic. Keep this on unless the
# deployment genuinely holds real records.
VITE_SHOW_SYNTHETIC_BANNER=true

# Print what a risk score does and does not mean wherever one is shown out of
# context. A score without its semantics is the easiest thing here to misread.
VITE_SHOW_SCORE_DISCLAIMER=true

# Show the platform's stated limitations in the interface, matching what is
# printed in every generated report.
VITE_SHOW_LIMITATIONS=true

# ---------------------------------------------------------------------------
# Formatting
# ---------------------------------------------------------------------------

# Currency code appended to amounts that carry no currency of their own. The
# interface never guesses a symbol: the platform ingests whatever the source
# system sends, so a guessed symbol would be wrong for some deployments.
VITE_DEFAULT_CURRENCY=INR

# Locale for number grouping.
VITE_DEFAULT_LOCALE=en-IN

# Timezone label shown beside timestamps. The API is UTC end to end, and
# timestamps are rendered with an explicit UTC suffix, so this is a label
# rather than a conversion.
VITE_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Where the dev server proxies /api. Inside Docker Compose this is
# http://backend:8000.
VITE_DEV_API_TARGET=http://localhost:8000
