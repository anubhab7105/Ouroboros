# -----------------------------------------------------------------------------
# Database: SQLAlchemy / PostgreSQL / SQLite
# -----------------------------------------------------------------------------
# Default is SQLite, so a fresh copy of this file works on a laptop with no
# database server installed. The path is relative to `backend/`, and
# `app/core/config.py` anchors it there, so it resolves to the same file
# whether you run from `backend/` or from the project root.
DATABASE_URL=sqlite+pysqlite:///./var/muleguard.db

# PostgreSQL is the source of truth for anything deployed -- see
# docs/adr/accepted/0002-postgresql-source-of-truth.md. Swap the two lines and
# set POSTGRES_PASSWORD below. `app/db.py` refuses SQLite outright when
# BACKEND_ENV is production-like, so this is not a decision you can forget.
# DATABASE_URL=postgresql+psycopg2://muleguard:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5432/muleguard

# DB_DRIVER is informational. The driver that is actually used comes from the
# scheme in DATABASE_URL above, so changing this alone changes nothing.
DB_DRIVER=postgresql+psycopg2
DB_APPLICATION_NAME=muleguard-backend
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_SECONDS=10
DB_DEADLOCK_RETRIES=2
DB_RETRY_TRANSIENT_ERRORS=true
DB_TRANSIENT_ERROR_CODES=40001,40P01,08006,08001
DB_CONNECTION_RETRIES=3
DB_RETRY_BACKOFF_SECONDS=1
DB_ECHO=false
DB_ECHO_POOL=false
DB_FUTURE=true
DB_AUTOCOMMIT=false
DB_AUTOFETCH=false
DB_EXPIRE_ON_COMMIT=true
DB_LAZY_LOAD_MAX=100
DB_JSON_SERIALIZER=stdjson
DB_JSON_DESERIALIZER=stdjson
DB_NUMERIC_DECIMAL_PLACES=2
DB_UUID_AS_STRING=true
DB_ENUM_CASE_SENSITIVE=true
DB_TIMEZONE_AWARE=true
DB_DEFAULT_TIMEZONE=UTC
DB_STRICT_TIMEZONE=true
DB_REJECT_NAIVE_TIMESTAMPS=true
DB_CONVERT_TO_UTC=true
DB_STORE_TIMESTAMP_WITH_TIMEZONE=true
DB_USE_SERVER_DEFAULTS=true
DB_ONCONFLICT_STRATEGY=raise
DB_SAVEPOINT_NESTING=true
DB_TRANSACTION_ISOLATION=READ COMMITTED
DB_MIGRATION_MODE=alembic
DB_CREATE_ALL_FOR_TESTS=true
DB_CREATE_ALL_IN_PRODUCTION=false
DB_STRICT_URL=true
DB_REJECT_SQLITE_IN_PRODUCTION=true
DB_ALLOW_SQLITE_FOR_LOCAL_DEV=true
DB_AUDIT_SCHEMA_CHANGES=true
DB_COMMENT_ENABLED=false
DB_QUERY_COMMENT_ENABLED=false
DB_SLOW_LOG_THRESHOLD_MS=1000
DB_EXPLAIN_ENABLED=false
DB_N_PLUS_ONE_GUARD=true
DB_EAGER_LOAD_ALLOWLIST=account_transactions,alert_evidence,case_events
DB_MAX_JOIN_DEPTH=5
DB_TIMEOUT_SECONDS=15
DB_READ_REPLICA_URL=
DB_FAILOVER_ENABLED=false
DB_MIGRATION_LOCK_ENABLED=true
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=60
DB_MIGRATION_LOCK_NAME=muleguard_alembic
DB_RESET_CONFIRM_PHRASE=RESET_SYNTHETIC_DEMO
DB_RESET_ALLOW_DEMO_ONLY=true
DB_RESET_BLOCK_PRODUCTION=true
DB_BACKUP_BEFORE_RESET=false
DB_SEPARATE_TEST_URL=true
DB_TEST_URL=sqlite:///./test_muleguard.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muleguard
POSTGRES_USER=muleguard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_SSL_MODE=prefer
POSTGRES_SSL_ROOT_CERT=
POSTGRES_SSL_CERT=
POSTGRES_SSL_KEY=
SQLITE_ENABLED_FOR_LOCAL_DEV=true
SQLITE_PATH=./muleguard.db
SQLITE_TEST_PATH=./test_muleguard.db
SQLITE_FOREIGN_KEYS=true
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BUSY_TIMEOUT=5000
SQLITE_CACHE_SIZE_MB=64
