# =============================================================================
# MULEGUARD backend environment example
# -----------------------------------------------------------------------------
# Copy this file to:
#   backend/.env
#
# Unix/macOS:
#   cp backend/.env.example backend/.env
#
# Windows PowerShell:
#   Copy-Item backend/.env.example backend/.env
#
# SECURITY RULES
#   1. Never commit the real backend/.env file.
#   2. Replace every CHANGE_ME value before running.
#   3. Do not put real customer data, real credentials, real bank data, or
#      production secrets in this file.
#   4. MULEGUARD is synthetic-first by default.
#   5. Dangerous, unimplemented, or unsafe feature flags must fail closed when
#      enabled unless the backend explicitly supports them.
#
# PRODUCT SAFETY
#   - Alerts, scores, graph relationships, and complaint correlations are
#     investigative leads only.
#   - The system must not implement automatic account freezing, payment
#     blocking, blacklisting, or other adverse customer action.
#   - Risk scores are investigative priority scores, not probabilities of guilt.
#   - Model metrics are synthetic-data evaluation metrics, not real-world
#     fraud-detection claims.
# =============================================================================


# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
BACKEND_APP_NAME=MULEGUARD
BACKEND_APP_MODULE=app.main:app
BACKEND_ENV=local
BACKEND_DEBUG=false
BACKEND_SAFE_MODE=true
BACKEND_STRICT_CONFIG=true
BACKEND_TIMEZONE=UTC
BACKEND_DEFAULT_LOCALE=en
BACKEND_DEFAULT_CURRENCY=INR
BACKEND_DATASET_MODE=synthetic
BACKEND_SYNTHETIC_BANNER_TEXT=SYNTHETIC DEMO DATA
BACKEND_API_PREFIX=/api/v1
BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://backend:8000
BACKEND_ROOT_PATH=
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BACKEND_TRUST_PROXY_HEADERS=false
BACKEND_FORWARDED_ALLOW_IPS=
BACKEND_REAL_IP_HEADER=X-Forwarded-For
BACKEND_MAX_FORWARDED_HOPS=1
BACKEND_REQUEST_TIMEOUT_SECONDS=60
BACKEND_MAX_REQUEST_BODY_MB=10
BACKEND_WORKERS=1
BACKEND_KEEP_ALIVE_TIMEOUT_SECONDS=5
BACKEND_GRACEFUL_TIMEOUT_SECONDS=20
BACKEND_LIFESPAN_STARTUP_TIMEOUT_SECONDS=120
BACKEND_LIFESPAN_SHUTDOWN_TIMEOUT_SECONDS=30
BACKEND_EXIT_ON_FATAL_CONFIG_ERROR=true
BACKEND_VALIDATE_ENV_ON_STARTUP=true
