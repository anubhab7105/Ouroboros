CI_ARTIFACT_DIR=var/ci-artifacts
CI_REPORT_DIR=var/ci-reports
CI_COVERAGE_DIR=var/coverage
CI_TEST_RESULTS_DIR=var/test-results
CI_SBOM_DIR=var/sbom
CI_SECRET_SCAN_DIR=var/secret-scan
CI_DEPENDENCY_AUDIT_DIR=var/dependency-audit
CI_CODEQL_DIR=var/codeql
CI_FAIL_ON_WARNINGS=false
CI_FAIL_ON_FLAKY=true
CI_RETRY_FAILED_TESTS=1
CI_PARALLELISM=1
CI_CACHE_DIR=var/ci-cache
CI_DETERMINISTIC_SEED=42
CI_SYNTHETIC_ONLY=true
CI_NO_NETWORK=true
CI_NO_REAL_DATA=true
TEST_DATABASE_URL=sqlite:///./test_muleguard.db
TEST_SEED=42
TEST_FIXTURE_DIR=tests/fixtures
TEST_CREATE_DISPOSABLE_SCHEMA=true
TEST_DROP_AFTER_SESSION=true
TEST_NO_NETWORK=true
TEST_NO_REAL_DATA=true
TEST_SYNTHETIC_ONLY=true
PYTEST_ARGS=-q
COVERAGE_FAIL_UNDER=0
COVERAGE_REPORT_DIR=var/coverage
JUNIT_XML_PATH=var/test-results/junit.xml


# -----------------------------------------------------------------------------
# Dependency / supply-chain audit (advisory by default)
# -----------------------------------------------------------------------------
DEPENDENCY_AUDIT_ENABLED=false
DEPENDENCY_AUDIT_FAIL_ON_SEVERITY=high
DEPENDENCY_AUDIT_EXCLUDE_DEV=false
DEPENDENCY_AUDIT_CACHE_TTL_HOURS=24
SUPPLY_CHAIN_SBOM_ENABLED=false
SUPPLY_CHAIN_VEX_ENABLED=false
SUPPLY_CHAIN_PROVENANCE_ENABLED=false
SUPPLY_CHAIN_ATTESTATION_ENABLED=false
SUPPLY_CHAIN_POLICY_FAIL_ON_CRITICAL=true
SUPPLY_CHAIN_POLICY_ALLOW_LICENSES=MIT,BSD-3-Clause,Apache-2.0,ISC,Python-2.0
SUPPLY_CHAIN_POLICY_DENY_LICENSES=GPL-3.0,AGPL-3.0
LICENSE_AUDIT_ENABLED=false
LICENSE_AUDIT_FAIL_ON_DENIED=true


# -----------------------------------------------------------------------------
# Final reminder
# -----------------------------------------------------------------------------
# This is a synthetic local prototype environment template.
# Do not use it with real customer data.
# Do not enable dangerous flags unless the backend explicitly supports them
# and the change has passed security, ML, graph, case, audit, and report tests.