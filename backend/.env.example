BACKEND_VALIDATE_ROLES_ON_STARTUP=true
BACKEND_VALIDATE_RULES_CONFIG_ON_STARTUP=true
BACKEND_VALIDATE_SCORING_CONFIG_ON_STARTUP=true
BACKEND_VALIDATE_FEATURE_SCHEMA_ON_STARTUP=true
BACKEND_VALIDATE_GRAPH_LIMITS_ON_STARTUP=true
BACKEND_VALIDATE_REPORT_SETTINGS_ON_STARTUP=true
BACKEND_WARN_ON_MISSING_ML_ARTIFACT=true
BACKEND_FAIL_ON_MISSING_ML_ARTIFACT=false
BACKEND_BLOCK_REAL_DATA_IF_SYNTHETIC_ONLY=true
BACKEND_BLOCK_DEMO_FEATURES_IN_PRODUCTION=true
BACKEND_BLOCK_SEEDING_IN_PRODUCTION=true
BACKEND_BLOCK_OPENAPI_IN_PRODUCTION=true
BACKEND_BLOCK_DEV_USERS_IN_PRODUCTION=true
BACKEND_REQUIRE_STRONG_SECRET_IN_NON_LOCAL=true
BACKEND_PRODUCTION_LIKE_ENVS=staging,production


